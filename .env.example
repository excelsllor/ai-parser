# Скопируйте в .env и заполните значения. Не коммитьте .env.

# --- Общие ---
APP_ENV=prod
BIND_ADDR=0.0.0.0:8080
LOG_JSON=true
TRUST_PROXY_HEADERS=false

# --- PostgreSQL ---
POSTGRES_USER=news
POSTGRES_PASSWORD=change-me-strong-postgres-password
POSTGRES_DB=news
DATABASE_URL=postgres://news:change-me-strong-postgres-password@postgres:5432/news

# --- Redis ---
REDIS_PASSWORD=change-me-strong-redis-password
REDIS_URL=redis://:change-me-strong-redis-password@redis:6379/0

# --- Kafka ---
KAFKA_BROKERS=kafka:9092
KAFKA_GROUP_PREFIX=news
# grpc — основной транспорт между сервисами; kafka — резервный
PIPELINE_TRANSPORT=grpc
GRPC_ADDR=0.0.0.0:50051
COLLECTOR_GRPC_URL=http://collector:50051
NORMALIZER_GRPC_URL=http://normalizer:50051
ANALYST_GRPC_URL=http://analyst:50051
CRITIC_GRPC_URL=http://critic:50051
REPORTER_GRPC_URL=http://reporter:50051
GRPC_TIMEOUT_SECS=600
# Для production: SASL_SSL + SCRAM-SHA-512 (нужна сборка rdkafka с feature ssl)
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-512
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CA_FILE=

# --- Auth (JWT_SECRET >= 32 символов; сгенерируйте: openssl rand -hex 48) ---
JWT_SECRET=change-me-48-bytes-hex-secret
ACCESS_TOKEN_TTL_MINUTES=60
REFRESH_TOKEN_TTL_DAYS=14
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-strong-admin-password

# --- LLM (vLLM OpenAI-compatible) ---
LLM_BASE_URL=http://host.docker.internal:8000/v1
LLM_API_KEY=
LLM_MODEL=Qwen2.5-14B-Instruct
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_TIMEOUT_SECS=90
LLM_CONCURRENCY=4
LLM_INPUT_PRICE_PER_1K=0
LLM_OUTPUT_PRICE_PER_1K=0

# --- ИИ-критик ---
CRITIC_LLM=true
CRITIC_MAX_LLM_CLAIMS=10

# --- SMTP (Mailpit для демонстрации; в prod используйте TLS) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=digest@example.local
SMTP_TLS=false
SMTP_STARTTLS=false
TEST_RECIPIENT=test@example.local

# --- Сбор новостей ---
LIVE_FETCH_ENABLED=true
ALLOWED_SOURCE_HOSTS=xakep.ru,kommersant.ru,ria.ru,ixbt.com,cnews.ru,habr.com
MAX_FETCH_BYTES=4194304
MAX_ARTICLES_PER_RUN=150
MAX_ARTICLES_PER_SOURCE=5
MAX_ARTICLE_CHARS=20000
CONTROL_TIMEZONE=Europe/Moscow

# --- Интерфейс / CORS ---
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
FRONTEND_DIR=/app/web

# --- Метрики ---
METRICS_PUBLIC=false
METRICS_TOKEN=change-me-metrics-token

# --- Веса ранжирования ---
WEIGHT_IMPACT=0.35
WEIGHT_SCALE=0.25
WEIGHT_URGENCY=0.20
WEIGHT_RELEVANCE=0.15
WEIGHT_CONFIDENCE=0.05
WEIGHT_UNCERTAINTY=0.15
PROMPT_VERSION=v1

# --- Docker image (для CI/CD) ---
IMAGE=service-backend:latest

# --- HTTPS (Caddy) ---
# COMPOSE_PROFILES=tls включает сервис caddy (порты 80/443).
# TLS_MODE=internal — самоподписанный сертификат для доступа по IP,
#   DOMAIN укажи как IP (1.2.3.4). Браузер будет предупреждать.
# TLS_MODE=public — Let's Encrypt (shortlived, ~6 дней). Домен или IP,
#   который указывает на этот сервер; нужны открытые 80/443.
#   Для IP Let's Encrypt выдаёт сертификат только через профиль shortlived.
COMPOSE_PROFILES=
TLS_MODE=internal
DOMAIN=localhost
# Порты хоста для Caddy (можно переопределить, если 80/443 заняты)
HTTP_PORT=80
HTTPS_PORT=443
